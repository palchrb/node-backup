# ===== Restic / Rclone =====
RESTIC_REPOSITORY="rclone:jotta:backups/NODE_NAME"
RESTIC_PASSWORD="CHANGE_ME_LONG_RANDOM_PASSWORD"
RCLONE_CONFIG="/home/ubuntu/.config/rclone/rclone.conf"
RESTIC_CACHE_DIR="/var/cache/restic"

# ===== What to back up =====
BACKUP_PATHS="/etc /srv/docker /var/backups /home/ubuntu"
EXCLUDES_FILE="/etc/node-backup-excludes.txt"

# ===== Retention =====
RETENTION_KEEP_DAILY=7
RETENTION_KEEP_WEEKLY=4
RETENTION_KEEP_MONTHLY=6

# ===== Status =====
STATUS_DIR="/var/log/node-backup"
NODE_BACKUP_NAME="node-backup"

# ===== Optional pre-backup command =====
# Leave empty to disable.
# Examples:
# PRE_BACKUP_COMMAND='/usr/local/bin/mysql-dump.sh'
# PRE_BACKUP_COMMAND='docker exec myapp /app/bin/export.sh'
PRE_BACKUP_COMMAND=""

# ===== Notifications =====
WEBHOOK_ENABLED="1"
WEBHOOK_URL="https://example.invalid/hooks/backup-error"
WEBHOOK_BEARER_TOKEN="CHANGE_ME"
