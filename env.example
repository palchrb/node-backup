# =============================================================================
# node-backup — configuration file
# =============================================================================
# Copy this file to /etc/default/node-backup and fill in the values.
# The installer creates this file automatically on first run.
#
# All variables that affect the systemd timer schedule (BACKUP_SCHEDULE,
# BACKUP_SCHEDULE_JITTER, NOTIFY_SCHEDULE) are applied to the timer units
# by re-running install.sh. All other variables are read at runtime.
# =============================================================================


# =============================================================================
# RESTIC / RCLONE SETTINGS
# =============================================================================

# Restic repository URL. Uses rclone as the storage backend.
# Format: rclone:<remote-name>:<path-on-remote>
# The <remote-name> must match a remote defined in your rclone.conf.
# Tip: use a node-specific subdirectory so each node has its own repo.
# Example: rclone:mys3bucket:backups/web01
RESTIC_REPOSITORY="rclone:myremote:backups/NODE_NAME"

# Password used to encrypt the restic repository.
# Choose a long, random string and store it somewhere safe (e.g. a password
# manager or secrets vault). Losing this password means losing access to all
# backups stored in this repository.
# Generate one: openssl rand -base64 32
RESTIC_PASSWORD="CHANGE_ME_LONG_RANDOM_PASSWORD"

# Absolute path to the rclone configuration file on this node.
# This file contains the remote definitions and their credentials.
# When running as root (via systemd) the default location is:
#   /root/.config/rclone/rclone.conf
RCLONE_CONFIG="/root/.config/rclone/rclone.conf"

# Local directory where restic caches repository metadata.
# Caching speeds up operations by avoiding repeated remote lookups.
# The directory is created automatically if it does not exist.
RESTIC_CACHE_DIR="/var/cache/restic"


# =============================================================================
# BACKUP PATHS
# =============================================================================

# Space-separated list of absolute paths to include in the backup.
# Paths that do not exist on this node are silently skipped, so you can
# use a shared template across nodes even if not all paths are present.
# Example: "/etc /home /srv/docker /var/backups"
BACKUP_PATHS="/etc /var/backups"

# Absolute path to a file containing exclusion patterns, one per line.
# Standard restic/glob patterns are supported (e.g. *.log, /tmp/**).
# The installer copies excludes.txt from the repo to this location.
EXCLUDES_FILE="/etc/node-backup-excludes.txt"


# =============================================================================
# RETENTION POLICY
# =============================================================================
# Controls how many old snapshots are kept when running restic forget --prune
# after each successful backup. Leave a variable empty (or remove it) to omit
# that particular rule from the forget command.

# Number of daily snapshots to keep (one snapshot per calendar day).
RETENTION_KEEP_DAILY=7

# Number of weekly snapshots to keep (one per week; typically the last
# snapshot taken in a given ISO week).
RETENTION_KEEP_WEEKLY=4

# Number of monthly snapshots to keep (one per calendar month).
RETENTION_KEEP_MONTHLY=6


# =============================================================================
# SCHEDULE
# =============================================================================
# These three values are written into the systemd timer unit files by install.sh.
# Unlike all other variables in this file, they cannot be read at runtime —
# systemd [Timer] directives do not support environment variable expansion.
# After changing any of them, re-run install.sh to apply the new schedule.
# Syntax reference: systemd.time(7) — `man systemd.time`

# When to run the backup job.
# Uses systemd OnCalendar syntax.
# Examples:
#   *-*-* 03:30:00     — every day at 03:30
#   Mon,Wed,Fri 02:00  — Monday, Wednesday, Friday at 02:00
#   weekly             — every Monday at 00:00
BACKUP_SCHEDULE="*-*-* 03:30:00"

# Maximum random delay added after the scheduled start time.
# Spreads the backup across a window so multiple nodes do not all hit the
# storage backend at exactly the same second.
# Uses systemd time-span syntax. Set to 0 to disable jitter entirely.
# Examples: 10min, 30min, 1h
BACKUP_SCHEDULE_JITTER="20min"

# When to run the failure-notification check.
# This timer reads the backup status file and fires the webhook if the last
# backup did not succeed. Set it to a time comfortably AFTER the latest
# possible backup completion (BACKUP_SCHEDULE + BACKUP_SCHEDULE_JITTER +
# expected backup duration).
# Uses systemd OnCalendar syntax (same format as BACKUP_SCHEDULE).
NOTIFY_SCHEDULE="*-*-* 09:00:00"

# When to run the weekly restic prune job.
# Prune is the RAM- and IO-intensive step that actually repacks and removes
# unreferenced data from the repository. Running it weekly rather than after
# every backup keeps daily backups fast and light.
# Set this to a time well outside normal backup hours (e.g. Sunday morning).
PRUNE_SCHEDULE="Sun *-*-* 04:30:00"

# =============================================================================
# MEMORY LIMITS
# =============================================================================
# These values are written into the systemd service unit files by install.sh.
# They set a hard cgroup memory cap on the backup and prune processes so they
# can never OOM-kill the rest of the system regardless of repository size.
# Re-run install.sh after changing.
#
# Rules of thumb:
#   BACKUP_MEMORY_MAX  — restic backup + forget is relatively light.
#                        500M–1500M is enough for most repositories.
#   PRUNE_MEMORY_MAX   — restic prune loads the full pack index into RAM.
#                        Allow more headroom here, especially for large or
#                        long-running repositories. On an 8 GB server 2G is
#                        a reasonable cap; lower it if the server is tighter.
#
# If restic is killed by the memory cap (exit code 137) you will see
# "MemoryMax" in journalctl output — raise the limit or run prune manually.

BACKUP_MEMORY_MAX="1500M"
PRUNE_MEMORY_MAX="2G"


# =============================================================================
# STATUS
# =============================================================================

# Directory where the backup writes its status file after each run.
# The notify script reads this file to determine whether to send an alert.
# The directory is created automatically if it does not exist.
STATUS_DIR="/var/log/node-backup"

# Human-readable identifier for this node included in webhook alert payloads.
# Use something that makes it easy to identify the server at a glance, e.g.
# the hostname, role, or environment (web01, db-prod, staging-api).
NODE_BACKUP_NAME="my-node"


# =============================================================================
# PRE- AND POST-BACKUP COMMANDS
# =============================================================================
# Optional shell commands or script paths to execute before/after the backup.
# Both are run with: bash -lc "<command>"
# Leave empty to disable.
#
# PRE_BACKUP_COMMAND:
#   Runs before the backup starts. If the command exits with a non-zero code,
#   the backup is aborted and the run is marked as failed.
#   Use this to dump databases, export application state, etc.
#
# POST_BACKUP_COMMAND:
#   Runs only when the backup itself succeeded (exit code 0 from restic).
#   A non-zero exit code is logged as a warning but does NOT change the
#   backup success status or trigger the failure webhook.
#   Use this for success notifications, cleanup tasks, etc.
#
# Examples:
#   PRE_BACKUP_COMMAND='/usr/local/lib/node-backup/pg-dump-all.sh'
#   PRE_BACKUP_COMMAND='mysqldump -u root --all-databases | gzip > /var/backups/mysql.sql.gz'
#   POST_BACKUP_COMMAND='/usr/local/bin/notify-success.sh'
#   POST_BACKUP_COMMAND='curl -fsS https://hc-ping.com/your-uuid'
PRE_BACKUP_COMMAND=""
POST_BACKUP_COMMAND=""


# =============================================================================
# POSTGRESQL DUMP (used by pg-dump-all.sh)
# =============================================================================
# pg-dump-all.sh auto-discovers and dumps all PostgreSQL instances — both a
# local bare metal install and any running Docker containers — before each
# backup. Enable it by setting:
#   PRE_BACKUP_COMMAND='/usr/local/lib/node-backup/pg-dump-all.sh'
#
# Dumps are written as compressed .sql.gz files, one per source, to PG_DUMP_DIR.
# Existing files are overwritten on each run; restic handles versioning.
# Make sure PG_DUMP_DIR is covered by BACKUP_PATHS.

# Directory where dump files are written.
# /var/backups/postgresql is already covered if /var/backups is in BACKUP_PATHS.
PG_DUMP_DIR="/var/backups/postgresql"

# Dump the local (bare metal) PostgreSQL instance.
# Connects via Unix socket as the postgres OS user — no password needed.
#   auto — dump if pg_isready reports postgres is running (default)
#   1    — always attempt; fail the backup if postgres is not reachable
#   0    — skip entirely
PG_DUMP_LOCAL="auto"

# Dump PostgreSQL running inside Docker containers.
# Containers are identified by image name (postgres, postgis) or by the
# presence of standard POSTGRES_USER / POSTGRES_DB / POSTGRES_PASSWORD
# environment variables. The POSTGRES_USER value is used as the dump user.
#   auto — dump if docker is available on this host (default)
#   1    — always attempt; fail the backup if docker is not found
#   0    — skip entirely
PG_DUMP_DOCKER="auto"


# =============================================================================
# MARIADB / MYSQL DUMP (used by mariadb-dump-all.sh)
# =============================================================================
# mariadb-dump-all.sh auto-discovers and dumps all MariaDB/MySQL instances —
# both a local bare metal install and any running Docker containers. Enable it
# by setting (alone or combined with pg-dump-all.sh):
#   PRE_BACKUP_COMMAND='/usr/local/lib/node-backup/mariadb-dump-all.sh'
#   PRE_BACKUP_COMMAND='/usr/local/lib/node-backup/pg-dump-all.sh && /usr/local/lib/node-backup/mariadb-dump-all.sh'
#
# Dumps are written as compressed .sql.gz files to MARIADB_DUMP_DIR.
# Make sure MARIADB_DUMP_DIR is covered by BACKUP_PATHS.

# Directory where dump files are written.
# /var/backups/mariadb is already covered if /var/backups is in BACKUP_PATHS.
MARIADB_DUMP_DIR="/var/backups/mariadb"

# Dump the local (bare metal) MariaDB/MySQL instance.
# Connects as root via Unix socket — works without a password on default
# Debian/Ubuntu installs (unix_socket auth plugin).
#   auto — dump if mysqladmin can reach the server (default)
#   1    — always attempt; fail the backup if the server is not reachable
#   0    — skip entirely
MARIADB_DUMP_LOCAL="auto"

# Dump MariaDB/MySQL in running Docker containers.
# Containers are identified by image name (mariadb, mysql) or by the presence
# of MYSQL_ROOT_PASSWORD / MARIADB_ROOT_PASSWORD / MYSQL_DATABASE env vars.
# The root password is read from the container's environment automatically.
#   auto — dump if docker is available on this host (default)
#   1    — always attempt; fail the backup if docker is not found
#   0    — skip entirely
MARIADB_DUMP_DOCKER="auto"


# =============================================================================
# WEBHOOK NOTIFICATIONS
# =============================================================================
# The notify timer runs once per day (at NOTIFY_SCHEDULE) and checks the
# backup status file. If the last backup failed, a JSON payload is POSTed
# to WEBHOOK_URL with an Authorization: Bearer header.
#
# The JSON payload looks like:
#   {
#     "service": "node-backup",
#     "node": "<NODE_BACKUP_NAME>",
#     "host": "<hostname>",
#     "status": "FAIL",
#     "timestamp": "2026-03-23T03:31:00+00:00",
#     "message": "Backup failed on <host> at <timestamp>"
#   }

# Set to "1" to enable webhook notifications. Set to "0" to disable.
WEBHOOK_ENABLED="1"

# Full URL of the webhook endpoint that receives failure alerts.
# Example: https://hooks.example.com/services/backup-alerts
WEBHOOK_URL="https://example.invalid/hooks/backup-error"

# Bearer token sent in the Authorization header of the webhook request.
# The receiving service should validate this token to authenticate the request.
WEBHOOK_BEARER_TOKEN="CHANGE_ME"
